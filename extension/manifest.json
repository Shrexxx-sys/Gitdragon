{
  "manifest_version": 3,
  "name": "Git Autopsy",
  "version": "0.3.0",
  "description": "A dragon that summarizes and roasts GitHub repos and profiles, using only real, checkable facts.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*", "https://*.vercel.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["pageDetect.js", "dragon.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["mascot/*"],
      "matches": ["https://github.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
