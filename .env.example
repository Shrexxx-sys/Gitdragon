# Copy this file to .env and fill in what you have.
# NEVER put real keys in THIS file: .env.example is committed to git. Real keys go in .env only.

# Port for the local backend
PORT=3000

# Optional: a GitHub personal access token (no scopes needed, "public repo" read only).
# Without it you get 60 GitHub API requests/hour. With it: 5000/hour, TODO counts via code search.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# SUMMARY model: auto | groq | gemini | openrouter | ollama | offline
#   auto    = first of groq, gemini, openrouter that has a key, else offline
#   offline = no AI, built-in templates (still 100% fact-based)
AI_PROVIDER=auto

# HUMOR model (writes + critiques the roast). Leave empty to use the summary model.
#   HUMOR_PROVIDER: groq | gemini | openrouter | ollama | offline
#   HUMOR_MODEL:    a model name for that provider (see below)
HUMOR_PROVIDER=
HUMOR_MODEL=

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier): https://aistudio.google.com/apikey
# Working free models (Nov 2026): gemini-3.5-flash, gemini-3.6-flash, gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter (free models end in ":free"): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama (free, runs on your own computer): https://ollama.com  then: ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Caches (save free-tier limits). Leave empty to disable.
GITHUB_CACHE_DIR=.cache
# Cache AI answers too (identical prompt = same answer, no API call). Handy while developing.
AI_CACHE_DIR=
