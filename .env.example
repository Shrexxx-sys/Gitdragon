# Copy this file to .env and fill in what you have. Never commit .env.

# Port for the local backend
PORT=3000

# Optional: a GitHub personal access token (no scopes needed, "public repo" read only).
# Without it you get 60 GitHub API requests/hour. With it: 5000/hour + pinned repos via GraphQL.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Which AI to use: auto | groq | gemini | ollama | offline
#   auto    = groq if GROQ_API_KEY is set, else gemini if GEMINI_API_KEY is set, else offline
#   offline = no AI, uses built-in templates (still 100% fact-based)
AI_PROVIDER=auto

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (free, runs on your own computer): https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Folder for caching GitHub responses on disk (saves your rate limit). Leave empty to disable.
GITHUB_CACHE_DIR=.cache
